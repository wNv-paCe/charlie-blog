# =========================
# Database
# =========================

# Application runtime connection (Neon pooled connection in production)
DATABASE_URL=

# Direct database connection for Alembic migrations
DATABASE_DIRECT_URL=


# =========================
# Security
# =========================

SECRET_KEY=

# Local HTTP development
COOKIE_SECURE=false


# =========================
# Frontend
# =========================

FRONTEND_URL=http://localhost:3000


# =========================
# S3 / Object Storage
# =========================

S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_URL=


# =========================
# Email
# =========================

MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true